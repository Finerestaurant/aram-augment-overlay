<Window x:Class="AramOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:app="clr-namespace:AramOverlay.App"
        Title="{app:Loc App.Title}" Height="596" Width="720"
        MinHeight="520" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="app.ico" Width="16" Height="16" />
                    <TextBlock Text="{app:Loc App.Title}" Foreground="{StaticResource Dim}"
                               FontSize="12.5" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimiseButton" Style="{StaticResource CaptionButton}"
                            Content="&#xE921;" Click="OnMinimise" ToolTip="{app:Loc Chrome.Minimise}" />
                    <Button x:Name="MaximiseButton" Style="{StaticResource CaptionButton}"
                            Content="&#xE922;" Click="OnMaximise" ToolTip="{app:Loc Chrome.Maximise}" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}"
                            Content="&#xE8BB;" Click="OnHideToTray" ToolTip="{app:Loc Chrome.HideToTray}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Segment switcher: two views, so no rail -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,10,16,0">
            <RadioButton x:Name="NavStatus" Style="{StaticResource SegmentButton}"
                         Content="{app:Loc Nav.Status}" IsChecked="True" Checked="OnNavChanged" />
            <RadioButton x:Name="NavSettings" Style="{StaticResource SegmentButton}"
                         Content="{app:Loc Nav.Settings}" Checked="OnNavChanged" />
        </StackPanel>

        <!-- Status -->
        <Grid x:Name="StatusView" Grid.Row="2" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="LogRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- One status line: what is being watched, and when something is
                 wrong, the button that fixes it, on the same line. -->
            <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="6" Padding="13,11"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusGlyphBg" Width="17" Height="17" CornerRadius="8.5"
                            Background="{StaticResource DimSoft}" VerticalAlignment="Top" Margin="0,1,0,0">
                        <TextBlock x:Name="StatusGlyph" Text="&#xE73E;" FontFamily="{StaticResource GlyphFont}"
                                   FontSize="9" FontWeight="Bold" Foreground="{StaticResource Dim}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0">
                        <TextBlock x:Name="StatusTitle" Text="{app:Loc Status.Starting}"
                                   Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource RowDesc}" FontSize="12.5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                Margin="11,0,0,0">
                        <!-- Where in OBS to look, as a picture of OBS itself: the
                             Tools menu open on "WebSocket Server Settings". Shown
                             only when OBS is up and not answering. -->
                        <Border x:Name="StatusHelp" Style="{StaticResource HelpDot}" Visibility="Collapsed"
                                Margin="0,3,10,0">
                            <TextBlock Text="?" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border.ToolTip>
                                <ToolTip>
                                    <StackPanel MaxWidth="460">
                                        <Image x:Name="HelpImage"
                                               Stretch="Uniform" StretchDirection="DownOnly"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{app:Loc Help.ObsWebsocket}" Style="{StaticResource RowDesc}"
                                                   Foreground="{StaticResource Text}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ToolTip>
                            </Border.ToolTip>
                        </Border>
                        <Button x:Name="StatusSecondary" Style="{StaticResource GhostButton}"
                                Content="{app:Loc Action.Retry}" Click="OnRetry" Visibility="Collapsed"
                                Margin="0,0,8,0" />
                        <Button x:Name="StatusAction" Style="{StaticResource AccentButton}"
                                Content="{app:Loc Action.TurnOn}" Click="OnStatusAction" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="2,0,2,8">
                <TextBlock Text="{app:Loc Status.Taken}" Style="{StaticResource RowTitle}" />
                <TextBlock x:Name="CountText" Text="0" HorizontalAlignment="Right"
                           Foreground="{StaticResource Dim}" FontSize="12.5" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource Sunken}" CornerRadius="7" Padding="6"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <!-- The empty state says what fills it, and when. -->
                    <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="300">
                        <TextBlock Text="{app:Loc Status.NoPicks}" Foreground="{StaticResource Dim}"
                                   FontSize="13" TextAlignment="Center" />
                        <TextBlock Text="{app:Loc Status.NoPicksDetail}" Style="{StaticResource Hint}"
                                   FontSize="12" TextAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PicksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One pick, built like the widget's card so the window
                                         and the stream agree: a rarity edge, the glyph on a
                                         wash of the same colour, the name over the rarity, and
                                         the level where the eye lands last. -->
                                    <Border Background="{StaticResource Panel}" CornerRadius="7"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            Padding="0,0,12,0" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="4" CornerRadius="6,0,0,6"
                                                    Background="{Binding RarityBrush}" />
                                            <!-- The icons ship as white line art; the glyph is
                                                 used as a mask and filled with the rarity colour,
                                                 the same way the widget does it. -->
                                            <Grid Grid.Column="1" Width="38" Height="38" Margin="12,9,0,9">
                                                <Border Background="{Binding RaritySoftBrush}" CornerRadius="6" />
                                                <Border Background="{Binding RarityBrush}" Margin="5">
                                                    <Border.OpacityMask>
                                                        <ImageBrush ImageSource="{Binding Icon}" Stretch="Uniform" />
                                                    </Border.OpacityMask>
                                                </Border>
                                            </Grid>
                                            <StackPanel Grid.Column="2" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource Text}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Rarity}" FontSize="11.5" Margin="0,2,0,0"
                                                           Foreground="{Binding RarityBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Background="{StaticResource Row}"
                                                    CornerRadius="4" Padding="7,2" Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding LevelVisibility}">
                                                <TextBlock Text="{Binding Level}" FontSize="11"
                                                           Foreground="{StaticResource Dim}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border x:Name="LogPanel" Grid.Row="3" Visibility="Collapsed"
                    Background="{StaticResource Sunken}" CornerRadius="7" Margin="0,14,0,0"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" Padding="12,10">
                    <TextBlock x:Name="LogText" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" Foreground="{StaticResource Dim}"
                               TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Settings: title and description on the left, the control on the
             right, so there is one axis for the eye to run down. -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="2" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" Margin="16,16,16,0">
            <StackPanel Margin="0,0,0,16">

                <TextBlock Text="{app:Loc Settings.Language}" Style="{StaticResource GroupTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource CardRowFirst}">
                            <DockPanel>
                                <ComboBox x:Name="UiLanguageBox" DockPanel.Dock="Right" Style="{StaticResource Combo}"
                                          SelectionChanged="OnUiLanguageChanged" />
                                <TextBlock Text="{app:Loc Settings.UiLanguage}" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardRow}">
                            <DockPanel>
                                <ComboBox x:Name="LocaleBox" DockPanel.Dock="Right" Style="{StaticResource Combo}"
                                          VerticalAlignment="Top" SelectionChanged="OnLocaleChanged" />
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{app:Loc Settings.GameLanguage}" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="OcrHint" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <!-- Shown only while the pack is missing. During the install
                             the row carries the elapsed time and a bar that says
                             the process is still alive; Windows gives no more. -->
                        <Border x:Name="OcrFixRow" Style="{StaticResource CardRow}" Visibility="Collapsed">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Style="{StaticResource GhostButton}"
                                            Content="{app:Loc Action.OpenLanguageSettings}"
                                            Click="OnOpenLanguageSettings" Margin="0,0,8,0" />
                                    <Button x:Name="InstallOcrButton" Style="{StaticResource AccentButton}"
                                            Content="{app:Loc Action.InstallOcr}" Click="OnInstallOcr" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{app:Loc Settings.OcrPack}" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="OcrPackDesc" Text="{app:Loc Hint.OcrPackRow}"
                                               Style="{StaticResource RowDesc}" />
                                    <ProgressBar x:Name="OcrProgress" Style="{StaticResource ActivityBar}"
                                                 Margin="0,10,0,2" Visibility="Collapsed" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="{app:Loc Settings.Game}" Style="{StaticResource GroupTitle}" />
                <Border Style="{StaticResource Card}">
                    <Border Style="{StaticResource CardRowFirst}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBox x:Name="WidthBox" Style="{StaticResource NumField}"
                                         TextChanged="OnResolutionChanged" />
                                <TextBlock Text="×" Margin="8,0" Foreground="{StaticResource Dim}"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="HeightBox" Style="{StaticResource NumField}"
                                         TextChanged="OnResolutionChanged" />
                                <ComboBox x:Name="PresetBox" Style="{StaticResource Combo}" Width="128"
                                          Margin="8,0,0,0" SelectionChanged="OnPresetChosen" />
                            </StackPanel>
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="{app:Loc Settings.GameResolution}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="ResolutionHint" Style="{StaticResource RowDesc}" />
                                <TextBlock x:Name="ScreenHint" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Border>

                <TextBlock Text="{app:Loc Settings.Obs}" Style="{StaticResource GroupTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource CardRowFirst}">
                            <DockPanel>
                                <TextBox x:Name="ObsPortBox" DockPanel.Dock="Right" Style="{StaticResource NumField}"
                                         TextChanged="OnSettingChanged" />
                                <TextBlock Text="{app:Loc Settings.ObsPort}" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardRow}">
                            <DockPanel>
                                <TextBox x:Name="ObsSourceBox" DockPanel.Dock="Right" Style="{StaticResource Field}"
                                         TextChanged="OnSettingChanged" />
                                <TextBlock Text="{app:Loc Settings.ObsSource}" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardRow}">
                            <DockPanel>
                                <TextBox x:Name="ObsPasswordBox" DockPanel.Dock="Right" Style="{StaticResource Field}"
                                         VerticalAlignment="Top" TextChanged="OnSettingChanged" />
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{app:Loc Settings.ObsPassword}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{app:Loc Hint.PasswordBlank}" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardRow}">
                            <DockPanel>
                                <Button x:Name="EnableWebsocketButton" DockPanel.Dock="Right"
                                        Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                                        Content="{app:Loc Action.TurnOn}" Click="OnEnableWebsocket" />
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{app:Loc Settings.Websocket}" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="WebsocketHint" Text="{app:Loc Hint.WebsocketOnce}"
                                               Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="{app:Loc Settings.Overlay}" Style="{StaticResource GroupTitle}" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Border Style="{StaticResource CardRowFirst}">
                            <StackPanel>
                                <TextBlock Text="{app:Loc Settings.WidgetTheme}" Style="{StaticResource RowTitle}"
                                           Margin="0,0,0,10" />
                                <!-- Real augments, fetched from the same list the widget draws
                                     from, masked and tinted the same way. A preview filled with
                                     coloured squares previews nothing that will ever be on screen.
                                     Names come from the game language, because that is the language
                                     the widget prints them in. -->
                                <UniformGrid Columns="3">
                                    <!-- b · HUD tray: square glyphs in a rarity frame, name under
                                         each, growing sideways. -->
                                    <RadioButton x:Name="ThemeTrayButton" GroupName="WidgetTheme"
                                                 Style="{StaticResource ThemeTile}"
                                                 Tag="{app:Loc Theme.HudTray}" Checked="OnWidgetThemeChosen">
                                        <Border Background="{StaticResource WTrayBg}" CornerRadius="3"
                                                BorderBrush="#47E3CDA7" BorderThickness="1" Padding="6,5">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Width="50" Margin="0,0,5,0">
                                                    <Border Width="28" Height="28" CornerRadius="2" HorizontalAlignment="Center"
                                                            Background="{StaticResource WGlyphBg}"
                                                            BorderBrush="{StaticResource WGold}" BorderThickness="1">
                                                        <Border Margin="4" Background="{StaticResource WGold}">
                                                            <Border.OpacityMask>
                                                                <ImageBrush x:Name="TrayGlyphGold" Stretch="Uniform" />
                                                            </Border.OpacityMask>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock x:Name="TrayNameGold" Text="{app:Loc Rarity.gold}"
                                                               FontSize="8" Foreground="#EDE7D8" TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Width="50" Margin="0,0,5,0">
                                                    <Border Width="28" Height="28" CornerRadius="2" HorizontalAlignment="Center"
                                                            Background="{StaticResource WGlyphBg}"
                                                            BorderBrush="{StaticResource WSilver}" BorderThickness="1">
                                                        <Border Margin="4" Background="{StaticResource WSilver}">
                                                            <Border.OpacityMask>
                                                                <ImageBrush x:Name="TrayGlyphSilver" Stretch="Uniform" />
                                                            </Border.OpacityMask>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock x:Name="TrayNameSilver" Text="{app:Loc Rarity.silver}"
                                                               FontSize="8" Foreground="#EDE7D8" TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Width="50">
                                                    <Border Width="28" Height="28" CornerRadius="2" HorizontalAlignment="Center"
                                                            Background="{StaticResource WGlyphBg}"
                                                            BorderBrush="{StaticResource WPrism}" BorderThickness="1">
                                                        <Border Margin="4" Background="{StaticResource WPrism}">
                                                            <Border.OpacityMask>
                                                                <ImageBrush x:Name="TrayGlyphPrism" Stretch="Uniform" />
                                                            </Border.OpacityMask>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock x:Name="TrayNamePrism" Text="{app:Loc Rarity.prismatic}"
                                                               FontSize="8" Foreground="#EDE7D8" TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </RadioButton>

                                    <!-- c · one strip: a single glass pill, rarity as a dot, no level. -->
                                    <RadioButton x:Name="ThemeStripButton" GroupName="WidgetTheme"
                                                 Style="{StaticResource ThemeTile}"
                                                 Tag="{app:Loc Theme.Strip}" Checked="OnWidgetThemeChosen">
                                        <Border Background="{StaticResource WStripBg}" CornerRadius="11" Height="22"
                                                BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="5,0"
                                                VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                                        Background="{StaticResource WGold}">
                                                    <Border.OpacityMask>
                                                        <ImageBrush x:Name="StripGlyphGold" Stretch="Uniform" />
                                                    </Border.OpacityMask>
                                                </Border>
                                                <TextBlock x:Name="StripNameGold" Text="{app:Loc Rarity.gold}"
                                                           FontSize="9" Foreground="#F1EEE6" VerticalAlignment="Center" />
                                                <Ellipse Width="4" Height="4" Fill="{StaticResource WGold}"
                                                         VerticalAlignment="Center" Margin="5,0,7,0" />
                                                <Border Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,4,0"
                                                        Background="{StaticResource WPrism}">
                                                    <Border.OpacityMask>
                                                        <ImageBrush x:Name="StripGlyphPrism" Stretch="Uniform" />
                                                    </Border.OpacityMask>
                                                </Border>
                                                <TextBlock x:Name="StripNamePrism" Text="{app:Loc Rarity.prismatic}"
                                                           FontSize="9" Foreground="#F1EEE6" VerticalAlignment="Center" />
                                                <Ellipse Width="4" Height="4" Fill="{StaticResource WPrism}"
                                                         VerticalAlignment="Center" Margin="5,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </RadioButton>

                                    <!-- d · game palette: today's rows, with the measured colours. -->
                                    <RadioButton x:Name="ThemePaletteButton" GroupName="WidgetTheme"
                                                 Style="{StaticResource ThemeTile}"
                                                 Tag="{app:Loc Theme.Palette}" Checked="OnWidgetThemeChosen">
                                        <StackPanel VerticalAlignment="Center">
                                            <Border Background="{StaticResource WCardBg}" CornerRadius="3"
                                                    Padding="4,3" Margin="0,0,5,0">
                                                <DockPanel>
                                                    <Rectangle DockPanel.Dock="Left" Width="3" Margin="0,0,5,0"
                                                               Fill="{StaticResource WGold}" RadiusX="1.5" RadiusY="1.5" />
                                                    <Border DockPanel.Dock="Left" Width="19" Height="19" Margin="0,0,6,0"
                                                            Background="{StaticResource WGold}">
                                                        <Border.OpacityMask>
                                                            <ImageBrush x:Name="PaletteGlyphGold" Stretch="Uniform" />
                                                        </Border.OpacityMask>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="PaletteNameGold" Text="{app:Loc Rarity.gold}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource WInk}" />
                                                        <TextBlock Text="{app:Loc Theme.SampleLevelA}" FontSize="7.5"
                                                                   Foreground="{StaticResource WGold}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <Border Background="{StaticResource WCardBg}" CornerRadius="3"
                                                    Padding="4,3" Margin="0,5,5,0">
                                                <DockPanel>
                                                    <Rectangle DockPanel.Dock="Left" Width="3" Margin="0,0,5,0"
                                                               Fill="{StaticResource WPrism}" RadiusX="1.5" RadiusY="1.5" />
                                                    <Border DockPanel.Dock="Left" Width="19" Height="19" Margin="0,0,6,0"
                                                            Background="{StaticResource WPrism}">
                                                        <Border.OpacityMask>
                                                            <ImageBrush x:Name="PaletteGlyphPrism" Stretch="Uniform" />
                                                        </Border.OpacityMask>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="PaletteNamePrism" Text="{app:Loc Rarity.prismatic}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource WInk}" />
                                                        <TextBlock Text="{app:Loc Theme.SampleLevelB}" FontSize="7.5"
                                                                   Foreground="#C99AF5" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardRow}">
                            <DockPanel>
                                <TextBox x:Name="WidgetPortBox" DockPanel.Dock="Right" Style="{StaticResource NumField}"
                                         TextChanged="OnSettingChanged" />
                                <TextBlock Text="{app:Loc Settings.WidgetPort}" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardRow}">
                            <DockPanel>
                                <TextBox x:Name="RowsBox" DockPanel.Dock="Right" Style="{StaticResource NumField}"
                                         TextChanged="OnSettingChanged" />
                                <TextBlock Text="{app:Loc Settings.Rows}" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardRow}">
                            <DockPanel>
                                <TextBox x:Name="MaxWidthBox" DockPanel.Dock="Right" Style="{StaticResource NumField}"
                                         TextChanged="OnSettingChanged" />
                                <TextBlock Text="{app:Loc Settings.MaxWidth}" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock Text="{app:Loc Settings.Advanced}" Style="{StaticResource GroupTitle}" />
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <Border Style="{StaticResource CardRowFirst}">
                            <DockPanel>
                                <CheckBox x:Name="DebugModeSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                          VerticalAlignment="Top" Margin="0,4,0,0" Click="OnDebugModeToggled" />
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{app:Loc Settings.DebugMode}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{app:Loc Hint.DebugMode}" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardRow}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                            VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Button x:Name="OpenInspectorButton" Style="{StaticResource GhostButton}"
                                            Content="{app:Loc Settings.OpenInspector}" Margin="0,0,10,0"
                                            Click="OnOpenInspector" />
                                    <CheckBox x:Name="InspectorSwitch" Style="{StaticResource Switch}"
                                              VerticalAlignment="Top" Margin="0,2,0,0" Click="OnInspectorToggled" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{app:Loc Settings.Inspector}" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="InspectorHint" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: the widget address is what gets pasted into OBS, so it is
             always in view; the screen's main buttons share the line. -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" Padding="16,10"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel x:Name="StatusActions" DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ResetButton" Style="{StaticResource GhostButton}"
                            Content="{app:Loc Action.Reset}" Click="OnReset" />
                    <Button x:Name="QuitButton" Style="{StaticResource GhostButton}"
                            Content="{app:Loc Action.Quit}" Click="OnQuit" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel x:Name="SettingsActions" DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="Collapsed">
                    <TextBlock x:Name="SavedHint" Style="{StaticResource RowDesc}" Margin="0,0,12,0"
                               VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <Button Style="{StaticResource GhostButton}" Content="{app:Loc Settings.Defaults}"
                            Click="OnResetSettings" />
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButton}"
                            Content="{app:Loc Settings.Save}" Click="OnSaveSettings" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="WidgetUrlText" Text="{app:Loc Status.WidgetPending}"
                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                    <Button x:Name="CopyUrlButton" Style="{StaticResource GhostButton}"
                            Content="{app:Loc Action.CopyUrl}" Margin="9,0,0,0" Click="OnCopyUrl" />
                    <!-- What the click did, said beside the button for a moment. -->
                    <TextBlock x:Name="CopyHint" Style="{StaticResource RowDesc}" FontSize="12"
                               Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Confirmation for the two things that cannot be taken back. Drawn in
             the window rather than as a MessageBox, which would arrive in the
             system theme and look like it belonged to a different program. -->
        <Grid x:Name="ConfirmVeil" Grid.RowSpan="4" Background="{StaticResource Veil}" Visibility="Collapsed"
              MouseLeftButtonDown="OnConfirmCancel">
            <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="20,18" Width="380"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseLeftButtonDown="OnConfirmCardClick">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" Foreground="{StaticResource Text}" FontSize="14"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ConfirmBody" Style="{StaticResource RowDesc}" FontSize="12.5"
                               Margin="0,8,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="{app:Loc Action.Cancel}"
                                Click="OnConfirmCancel" />
                        <Button x:Name="ConfirmOk" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                Click="OnConfirmOk" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
