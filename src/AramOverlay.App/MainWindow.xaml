<Window x:Class="AramOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:app="clr-namespace:AramOverlay.App"
        Title="{app:Loc App.Title}" Height="620" Width="860"
        MinHeight="560" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource Rail}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="app.ico" Width="18" Height="18" />
                <TextBlock Text="{app:Loc App.Title}" Foreground="{StaticResource Text}"
                           FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,4,4,4">
                <Button x:Name="MinimiseButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="OnMinimise" ToolTip="{app:Loc Chrome.Minimise}" />
                <Button x:Name="MaximiseButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="OnMaximise" ToolTip="{app:Loc Chrome.Maximise}" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseButton}"
                        Content="&#xE8BB;" Click="OnHideToTray" ToolTip="{app:Loc Chrome.HideToTray}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left rail -->
            <Border Grid.Column="0" Background="{StaticResource Rail}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <RadioButton x:Name="NavStatus" Style="{StaticResource NavButton}"
                                     Content="{app:Loc Nav.Status}" IsChecked="True" Checked="OnNavChanged" />
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                     Content="{app:Loc Nav.Settings}" Checked="OnNavChanged" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
                        <TextBlock x:Name="WidgetUrlText" Style="{StaticResource Hint}"
                                   Text="{app:Loc Status.WidgetPending}" />
                        <Button x:Name="CopyUrlButton" Style="{StaticResource GhostButton}"
                                Content="{app:Loc Action.CopyUrl}" Margin="0,10,0,0" Padding="10,7"
                                Click="OnCopyUrl" />
                    </StackPanel>
                    <Grid />
                </DockPanel>
            </Border>

            <!-- Status -->
            <Grid x:Name="StatusView" Grid.Column="1" Margin="24,20,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="LogRow" Height="0" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,9"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ObsDot" Width="8" Height="8"
                                     Fill="{StaticResource Dim}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ObsText" Text="{app:Loc Status.Starting}" Margin="9,0,0,0"
                                       Foreground="{StaticResource Text}" FontSize="12.5" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,9"
                            Margin="10,0,0,0"
                            BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="GameDot" Width="8" Height="8"
                                     Fill="{StaticResource Dim}" VerticalAlignment="Center" />
                            <TextBlock x:Name="GameText" Text="{app:Loc Status.WaitingForGame}" Margin="9,0,0,0"
                                       Foreground="{StaticResource Text}" FontSize="12.5" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="CountText" Grid.Row="1" Text=""
                           Style="{StaticResource SectionLabel}" />

                <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="EmptyText" Text="{app:Loc Status.NoPicks}"
                                   Foreground="{StaticResource Faint}" FontSize="12.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                            <ItemsControl x:Name="PicksList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#22222B" CornerRadius="8"
                                                Margin="6,5" Padding="0,0,14,0">
                                            <Grid Height="52">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="4" Margin="0,10"
                                                        CornerRadius="2"
                                                        Background="{Binding RarityBrush}" />
                                                <StackPanel Grid.Column="1" Margin="14,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource Text}"
                                                               FontSize="13.5" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Sub}" Margin="0,3,0,0"
                                                               Foreground="{Binding RarityBrush}"
                                                               FontSize="11.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Confidence}"
                                                           Foreground="{StaticResource Faint}"
                                                           FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="ResetButton" Style="{StaticResource GhostButton}"
                                Content="{app:Loc Action.Reset}" Click="OnReset" />
                        <Button x:Name="RetryButton" Style="{StaticResource AccentButton}"
                                Content="{app:Loc Action.Retry}" Margin="10,0,0,0" Click="OnRetry"
                                Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="QuitButton" Style="{StaticResource GhostButton}"
                            Content="{app:Loc Action.Quit}" Click="OnQuit" HorizontalAlignment="Right" />
                </Grid>

                <Border x:Name="LogPanel" Grid.Row="4" Visibility="Collapsed"
                        Background="#121217" CornerRadius="10" Margin="0,14,0,0"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto" Padding="12,10">
                        <TextBlock x:Name="LogText" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Foreground="{StaticResource Dim}"
                                   TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsView" Grid.Column="1" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,10,24,24">
                    <TextBlock Text="{app:Loc Settings.Language}" Style="{StaticResource SectionLabel}" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{app:Loc Settings.UiLanguage}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="UiLanguageBox" Grid.Column="1" Style="{StaticResource Combo}"
                                  SelectionChanged="OnUiLanguageChanged" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{app:Loc Settings.GameLanguage}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="LocaleBox" Grid.Column="1" Style="{StaticResource Combo}"
                                  SelectionChanged="OnLocaleChanged" />
                    </Grid>
                    <TextBlock x:Name="OcrHint" Style="{StaticResource Hint}" />
                    <StackPanel x:Name="OcrFixRow" Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="InstallOcrButton" Style="{StaticResource GhostButton}"
                                Content="{app:Loc Action.InstallOcr}" Padding="12,7"
                                Click="OnInstallOcr" />
                        <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Padding="12,7"
                                Content="{app:Loc Action.OpenLanguageSettings}"
                                Click="OnOpenLanguageSettings" />
                    </StackPanel>

                    <TextBlock Text="{app:Loc Settings.Resolution}" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="ScreenHint" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{app:Loc Settings.GameResolution}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="WidthBox" Grid.Column="1" Style="{StaticResource Field}"
                                 TextChanged="OnResolutionChanged" />
                        <TextBlock Grid.Column="2" Text="×" Margin="10,0"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="HeightBox" Grid.Column="3" Style="{StaticResource Field}"
                                 TextChanged="OnResolutionChanged" />
                        <ComboBox x:Name="PresetBox" Grid.Column="4" Style="{StaticResource Combo}"
                                  Margin="10,0,0,0" SelectionChanged="OnPresetChosen" />
                    </Grid>
                    <TextBlock x:Name="ResolutionHint" Style="{StaticResource Hint}" />

                    <TextBlock Text="OBS" Style="{StaticResource SectionLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{app:Loc Settings.ObsPort}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ObsPortBox" Grid.Column="1" Style="{StaticResource Field}"
                                 HorizontalAlignment="Left" Width="120" />
                        <TextBlock Grid.Row="1" Text="{app:Loc Settings.ObsSource}" Style="{StaticResource FieldLabel}"
                                   Margin="0,8,0,0" />
                        <TextBox x:Name="ObsSourceBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                 Style="{StaticResource Field}" />
                        <TextBlock Grid.Row="2" Text="{app:Loc Settings.ObsPassword}" Style="{StaticResource FieldLabel}"
                                   Margin="0,8,0,0" />
                        <TextBox x:Name="ObsPasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                 Style="{StaticResource Field}" />
                    </Grid>
                    <TextBlock Text="{app:Loc Hint.PasswordBlank}"
                               Style="{StaticResource Hint}" />
                    <Button x:Name="EnableWebsocketButton" Style="{StaticResource GhostButton}"
                            Content="{app:Loc Settings.EnableWebsocket}" HorizontalAlignment="Left"
                            Margin="0,10,0,0" Click="OnEnableWebsocket" />
                    <TextBlock x:Name="WebsocketHint" Style="{StaticResource Hint}" />

                    <TextBlock Text="{app:Loc Settings.Overlay}" Style="{StaticResource SectionLabel}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{app:Loc Settings.WidgetPort}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="WidgetPortBox" Grid.Column="1" Style="{StaticResource Field}"
                                 HorizontalAlignment="Left" Width="120" />
                        <TextBlock Grid.Row="1" Text="{app:Loc Settings.Rows}" Style="{StaticResource FieldLabel}"
                                   Margin="0,8,0,0" />
                        <TextBox x:Name="RowsBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                 Style="{StaticResource Field}" HorizontalAlignment="Left" Width="120" />
                        <TextBlock Grid.Row="2" Text="{app:Loc Settings.MaxWidth}" Style="{StaticResource FieldLabel}"
                                   Margin="0,8,0,0" />
                        <TextBox x:Name="MaxWidthBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                 Style="{StaticResource Field}" HorizontalAlignment="Left" Width="120" />
                    </Grid>

                    <TextBlock Text="{app:Loc Settings.Advanced}" Style="{StaticResource SectionLabel}" />
                    <CheckBox x:Name="DebugModeSwitch" Style="{StaticResource Switch}"
                              Content="{app:Loc Settings.DebugMode}" Click="OnDebugModeToggled" />
                    <TextBlock Text="{app:Loc Hint.DebugMode}" Style="{StaticResource Hint}" />

                    <TextBlock x:Name="SavedHint" Style="{StaticResource Hint}" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="{app:Loc Settings.Save}"
                                Click="OnSaveSettings" />
                        <Button Style="{StaticResource GhostButton}" Content="{app:Loc Settings.Defaults}"
                                Margin="10,0,0,0" Click="OnResetSettings" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
