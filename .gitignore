# 빌드 산출물
src/**/bin/
src/**/obj/
publish/

# 실행 중 만들어지는 것들 (exe 옆에 생긴다)
data/
state/
config.json
*.log

# 파이썬 구현이 남긴 것들. 소스는 커밋 ecd9cb5 이전에 있다.
.venv/
build/
dist/
__pycache__/
*.pyc

# Full calibration capture set and run logs stay local -- tests/fixtures/ holds
# the handful the self test needs, and the measurements taken from the rest are
# written up in docs/FINDINGS.md.
captures/
logs/

# Frames pulled from third-party gameplay video were used for calibration.
# Measurements taken from them are fine to publish; the images are not.
video/
vidframes/
frames_*/
